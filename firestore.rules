rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Audit log: only the two admins can read, only the Cloud Function (Admin SDK) can write.
    match /auditLog/{id} {
      allow read: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['littendekitten@gmail.com', 'kitacatservice@gmail.com'];
      allow write: if false;
    }
  }
}
